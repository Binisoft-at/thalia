// Thalia – CloudKit schema of iCloud.at.binisoft.thalia (SwiftData mirroring: CD_ prefix, one
// record type per synced @Model, no relationships – records refer to each other by keys).
//
// Generated from Shared/Models.swift by tools/schema-from-models.py. HealthValue is device-only (App Store guideline
// 5.1.3(ii)) and has no record type. Order on every model change:
//   1. add the field here   2. Actions → CloudKit schema (imports into Development)
//   3. CloudKit Console → Deploy Schema Changes to Production   4. then the TestFlight build.
// Production only accepts additive changes: never rename or remove a field.

DEFINE SCHEMA

    RECORD TYPE CD_AnnualGoal (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_createdAt  TIMESTAMP,
        CD_deletedAt  TIMESTAMP,
        CD_details    STRING,
        CD_entityName STRING,
        CD_key        STRING,
        CD_modifiedAt TIMESTAMP,
        CD_title      STRING,
        CD_uuid       STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

