# App settings for the shared CI scripts (scripts/ci, synced from the Binisoft handbook).
# This file belongs to the app; sync never touches it. Defaults are derived from APP_NAME.
APP_NAME=Thalia

# Schemes and paths (defaults shown):
# IOS_SCHEME=Thalia
# MAC_SCHEME=ThaliaMac
# WATCH_SCHEME=ThaliaWatch
# WIDGETS_TARGET=ThaliaWidgets
# CORE_PACKAGE=Packages/ThaliaCore

# Targets this app has (1 = yes, 0 = no):
HAS_MAC=1
HAS_WATCH=1
HAS_WIDGETS=1

# [screenshots] runs: screens opened with `-Demo -DemoScreen <name>` (see AppModel.applyLaunchOptions).
# "tour" opens the tour; "tour:<step>" opens it at a step.
SCREENSHOT_SCREENS="today overview focus expenses work week close-day close-week pdf-week create settings tour"
WATCH_SCREENS="today"
MAC_SCREENS="today week goals close-day"
