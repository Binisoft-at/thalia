# App settings for the shared CI scripts (scripts/ci, synced from the Binisoft handbook).
# This file belongs to the app; sync never touches it. Defaults are derived from APP_NAME.
APP_NAME=Thalia

# Schemes and paths (defaults shown):
# IOS_SCHEME=Thalia
# MAC_SCHEME=ThaliaMac
# WATCH_SCHEME=ThaliaWatch
# WIDGETS_TARGET=ThaliaWidgets
# CORE_PACKAGE=Packages/ThaliaCore

# Targets this app has (1 = yes, 0 = no):
HAS_MAC=1
HAS_WATCH=1
HAS_WIDGETS=1

# Entitlements checked in the iOS archive (scripts/ci/check-entitlements.sh). Replaces the default
# list, so all four bundles are named – the watch complication lives inside the watch app (R86).
ENTITLEMENTS_IOS="Thalia.app|Config/iOS/Thalia.entitlements Thalia.app/Watch/ThaliaWatch.app|Config/watchOS/ThaliaWatch.entitlements Thalia.app/PlugIns/ThaliaWidgets.appex|Config/Widgets/ThaliaWidgets.entitlements Thalia.app/Watch/ThaliaWatch.app/PlugIns/ThaliaWatchWidgets.appex|Config/WatchWidgets/ThaliaWatchWidgets.entitlements"

# [screenshots] runs: screens opened with `-Demo -DemoScreen <name>` (see AppModel.applyLaunchOptions).
# "tour" opens the tour; "tour:<step>" opens it at a step.
SCREENSHOT_SCREENS="today overview focus expenses work week close-day create weekly-goals goal-review past-import range-pdf"
WATCH_SCREENS="today"
MAC_SCREENS="today week goals close-day overview past-import range-pdf"
