        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MeasureDefinition (
        CD_aggregationRaw STRING,
        CD_categoryKey    STRING,
        CD_code           STRING,
        CD_createdAt      TIMESTAMP,
        CD_daysMask       INT64,
        CD_deletedAt      TIMESTAMP,
        CD_details        STRING,
        CD_entityName     STRING,
        CD_modifiedAt     TIMESTAMP,
        CD_periodRaw      STRING,
        CD_position       INT64,
        CD_sourceRaw      STRING,
        CD_targetRaw      STRING,
        CD_title          STRING,
        CD_unit           STRING,
        CD_uuid           STRING,
        CD_weekKey        STRING,
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MeasureEntry (
        CD_code         STRING,
        CD_createdAt    TIMESTAMP,
        CD_dayKey       STRING,
        CD_deletedAt    TIMESTAMP,
        CD_entityName   STRING,
        CD_isEstimate   INT64,
        CD_modifiedAt   TIMESTAMP,
        CD_note         STRING,
        CD_recordedAt   TIMESTAMP,
        CD_text         STRING,
        CD_uuid         STRING,
        CD_value        DOUBLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
