DEFINE SCHEMA

    RECORD TYPE CD_AnnualGoal (
        CD_createdAt    TIMESTAMP,
        CD_deletedAt    TIMESTAMP,
        CD_details      STRING,
        CD_entityName   STRING,
        CD_key          STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_title        STRING,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_AppSetting (
        CD_entityName   STRING,
        CD_key          STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_uuid         STRING,
        CD_value        STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DayNote (
        CD_createdAt    TIMESTAMP,
        CD_dayKey       STRING,
        CD_deletedAt    TIMESTAMP,
        CD_entityName   STRING,
        CD_importID     STRING,
        CD_kindRaw      STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_text         STRING,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ItemMark (
        CD_createdAt    TIMESTAMP,
        CD_dayKey       STRING,
        CD_entityName   STRING,
        CD_itemCode     STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_note         STRING,
        CD_uuid         STRING,
        CD_valueRaw     STRING,
        CD_weekKey      STRING,
