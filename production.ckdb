        CD_details      STRING,
        CD_entityName   STRING,
        CD_isKnockout   INT64,
        CD_measureCode  STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_position     INT64,
        CD_scheduleRaw  STRING,
        CD_targetRaw    STRING,
        CD_title        STRING,
        CD_uuid         STRING,
        CD_weekKey      STRING,
