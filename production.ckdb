        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TrackCategory (
        CD_createdAt    TIMESTAMP,
        CD_deletedAt    TIMESTAMP,
        CD_details      STRING,
        CD_entityName   STRING,
        CD_goalKey      STRING,
        CD_key          STRING,
        CD_modifiedAt   TIMESTAMP,
        CD_title        STRING,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WeekArchive (
        CD_archivedAt   TIMESTAMP,
        CD_csv          STRING,
        CD_entityName   STRING,
        CD_itemCount    INT64,
        CD_markCount    INT64,
        CD_modifiedAt   TIMESTAMP,
        CD_title        STRING,
        CD_uuid         STRING,
        CD_weekKey      STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WeekPlan (
        CD_closedAt         TIMESTAMP,
        CD_createdAt        TIMESTAMP,
        CD_deletedAt        TIMESTAMP,
        CD_details          STRING,
        CD_entityName       STRING,
        CD_finalGoalScores  STRING,
        CD_finalGoalsScored INT64,
        CD_finalScore       DOUBLE,
        CD_importedAt       TIMESTAMP,
        CD_modifiedAt       TIMESTAMP,
        CD_recordedScore    DOUBLE,
        CD_scoringModel     STRING,
        CD_title            STRING,
        CD_uuid             STRING,
        CD_weekKey          STRING,
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WorkBlock (
        CD_categoryKey  STRING,
        CD_createdAt    TIMESTAMP,
        CD_dayKey       STRING,
        CD_deletedAt    TIMESTAMP,
        CD_endedAt      TIMESTAMP,
        CD_entityName   STRING,
        CD_importID     STRING,
        CD_isRunning    INT64,
        CD_kindRaw      STRING,
        CD_minutes      INT64,
        CD_modifiedAt   TIMESTAMP,
        CD_nextStep     STRING,
        CD_powerHours   DOUBLE,
        CD_result       STRING,
        CD_startedAt    TIMESTAMP,
        CD_task         STRING,
        CD_uuid         STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
